digraph RepositoryArchitecture {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.65", splines=ortho, label="4-TERMX — Arquitectura / relaciones", labelloc=t, fontsize=20];
  node [fontname="Arial", fontsize=10, style="rounded,filled", color="#555555", fillcolor="white"];
  edge [color="#777777", arrowsize=0.65];
  root [label="4-TERMX", shape=box, fillcolor="#eeeeee", fontsize=15];
  dir_n__github [label=".github", shape=box, fillcolor="#eeeeee"];
  root -> dir_n__github;
  dir_n__termux [label=".termux", shape=box, fillcolor="#eeeeee"];
  root -> dir_n__termux;
  dir_n_docs [label="docs", shape=box, fillcolor="#eeeeee"];
  root -> dir_n_docs;
  dir_n_infrastructure [label="infrastructure", shape=box, fillcolor="#eeeeee"];
  root -> dir_n_infrastructure;
  dir_n_scripts [label="scripts", shape=box, fillcolor="#eeeeee"];
  root -> dir_n_scripts;
  file_n__gitconfig [label=".gitconfig", shape=note];
  root -> file_n__gitconfig;
  file_n__gitignore [label=".gitignore", shape=note];
  root -> file_n__gitignore;
  file_n__zshrc [label=".zshrc", shape=note];
  root -> file_n__zshrc;
  file_n_CONTRIBUTING_md [label="CONTRIBUTING.md", shape=note];
  root -> file_n_CONTRIBUTING_md;
  file_n_README_md [label="README.md", shape=note];
  root -> file_n_README_md;
  file_n_SECURITY_md [label="SECURITY.md", shape=note];
  root -> file_n_SECURITY_md;
  file_n_sync_repo_sh [label="sync-repo.sh", shape=note];
  root -> file_n_sync_repo_sh;
  file_n_update_readme_tree_py [label="update_readme_tree.py", shape=note];
  root -> file_n_update_readme_tree_py;
  workflow [label="update-tree.yml\nGitHub Actions", shape=box, fillcolor="#f3f3f3"];
  dir_n__github -> workflow;
  generator [label="update_readme_tree.py\ndescubre + genera", shape=box, fillcolor="#f3f3f3"];
  root -> generator;
  readme [label="README.md", shape=note, fillcolor="white"];
  root -> readme;
  docs [label="docs", shape=box, fillcolor="#eeeeee"];
  root -> docs;
  doc_n_docs_conocimiento_4_termx_md [label="conocimiento-4-termx.md", shape=note];
  docs -> doc_n_docs_conocimiento_4_termx_md;
  doc_n_docs_design_principles_md [label="design-principles.md", shape=note];
  docs -> doc_n_docs_design_principles_md;
  doc_n_docs_infrastructure_md [label="infrastructure.md", shape=note];
  docs -> doc_n_docs_infrastructure_md;
  doc_n_docs_pendientes_evolucion_md [label="pendientes-evolucion.md", shape=note];
  docs -> doc_n_docs_pendientes_evolucion_md;
  doc_n_docs_repository_map_md [label="repository-map.md", shape=note];
  docs -> doc_n_docs_repository_map_md;
  doc_n_docs_svg2canvas_py [label="svg2canvas.py", shape=note];
  docs -> doc_n_docs_svg2canvas_py;
  workflow -> generator [label="ejecuta"];
  generator -> readme [label="actualiza"];
  generator -> doc_n_docs_repository_map_md [label="genera"];
  github [label="GitHub", shape=box, fillcolor="#eeeeee"];
  actions [label="GitHub Actions", shape=box, fillcolor="#eeeeee"];
  root -> github [style=dashed, label="repositorio"];
  github -> actions [style=dashed];
  actions -> workflow [style=dashed, label="workflow"];
}
